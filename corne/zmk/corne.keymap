#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "QWERTY";
            bindings = <
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                                           &kp LGUI  &mo 2  &kp SPACE          &kp RET   &mo 3     &kp RALT
            >;
        };

        colemak_dh {
            display-name = "Colemak-DH";
            bindings = <
                &kp TAB    &kp Q     &kp W     &kp F     &kp P     &kp B        &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp BSPC
                &kp LCTRL  &kp A     &kp R     &kp S     &kp T     &kp G        &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp D     &kp V        &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                                           &kp LGUI  &mo 2  &kp SPACE          &kp RET   &mo 3     &kp RALT
            >;
        };

        lower {
            display-name = "Lower";
            bindings = <
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
                &to 0      &to 1     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR   &none &none &none &none &none &kp F12
                                           &trans    &trans    &trans           &trans    &trans    &trans
            >;
        };

        raise {
            display-name = "Raise";
            bindings = <
                &kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp DEL
                &trans     &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH     &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp PIPE  &kp TILDE
                &trans     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &none        &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp C_MUTE &kp C_PP
                                           &trans    &trans    &trans           &trans    &trans    &trans
            >;
        };
    };
};
